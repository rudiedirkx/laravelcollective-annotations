{
    "name": "rdx/laravelcollective-annotations",
    "description": "Route Annotations for The Laravel Framework.",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/rudiedirkx/laravelcollective-annotations/issues",
        "source": "https://github.com/rudiedirkx/laravelcollective-annotations/annotations"
    },
    "replace": {
        "laravelcollective/annotations": "self.version"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^13.0 || ^12.0 || ^11.0",
        "illuminate/filesystem": "^13.0 || ^12.0 || ^11.0",
        "illuminate/support": "^13.0 || ^12.0 || ^11.0"
    },
    "require-dev": {
        "illuminate/database": "^13.0 || ^12.0 || ^11.0",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0",
        "symfony/var-dumper": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Collective\\Annotations\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
